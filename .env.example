# Copy this file to .env and replace the placeholder with your server-side key.
# Never put this value in public/reader.html, public/js/reader.js, or browser localStorage.
DEEPSEEK_API_KEY=PASTE_YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat

# Optional for scanned answer PDFs. Leave unset to auto-detect installed packs.
# CET_OCR_LANGUAGES=eng+chi_sim
